# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doc_automation

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

HMAC_SECRET=change_this_to_a_long_random_string_too

# FR-024: per-approver signing secrets are stored encrypted in users.signing_secret_enc
# using EXTERNAL_DB_ENC_KEY (AES-256-GCM). Set EXTERNAL_DB_ENC_KEY to a long random
# value in production — losing this key means existing per-approver HMAC signatures
# can no longer be decrypted for verification (they fall back to HMAC_SECRET legacy check).

EXTERNAL_DB_ENC_KEY=change_this_to_a_long_random_string_as_well

# FR-026: NTP server for legally-defensible signing timestamps.
# Defaults to pool.ntp.org if not set. Falls back to system clock with a warning if unreachable.
NTP_SERVER=pool.ntp.org
NTP_PORT=123
NTP_TIMEOUT_MS=3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bimelshabtamu152@gmail.com
SMTP_PASSWORD=yuqwxvmhixzxsaaj
SMTP_FROM=DocuVault

SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PHONE_DEFAULT_COUNTRY_CODE=251
