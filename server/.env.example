# =====================================================================
# TEMPLATE — copy to .env for local dev, or paste the values into your
# hosting provider's dashboard as environment variables.
#
# NEVER put real credentials in this file. It IS tracked in git, so anything
# written here ends up in permanent git history even after you delete it later.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================================

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. Production needs at least the
# frontend's Vercel domain; add Vercel preview domains here as they appear.
#   CLIENT_URL=https://yourapp.vercel.app,https://app.yourdomain.com
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# Where uploaded/generated files are written.
# Leave UNSET locally (defaults to ./storage). In production set this to the
# mount path of a persistent disk, e.g. /var/data, or every redeploy will
# silently delete all generated PDFs, logos and avatars.
# STORAGE_ROOT=/var/data

# ── MySQL ────────────────────────────────────────────────────────────────────
# Works with local XAMPP as well as managed MySQL (Aiven, PlanetScale, Railway…).
# Managed providers require TLS — set DB_SSL=true and paste their CA in DB_SSL_CA.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doc_automation
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate a fresh value for each. These sign and encrypt user sessions, document
# integrity hashes and per-approver signing keys — reusing a value across
# environments means a key leaked from dev is valid in production.
JWT_SECRET=
JWT_EXPIRES_IN=8h

HMAC_SECRET=

# 32-char key for the external-database connection passwords (AES-256-GCM).
EXTERNAL_DB_ENC_KEY=


# FR-026: NTP server for legally-defensible signing timestamps.
# Defaults to pool.ntp.org if not set. Falls back to system clock with a warning if unreachable.
NTP_SERVER=pool.ntp.org
NTP_PORT=123
NTP_TIMEOUT_MS=3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Use a Google APP PASSWORD (myaccount.google.com → Security → App passwords),
# never your account password. Requires 2FA to be on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=DocuVault

# ── Redis (required) ──────────────────────────────────────────────────────────
# REQUIRED for the bulk PDF generation queue (FR-019 / NFR-004). The server
# refuses to start if Redis is unreachable, so this must be set in production.
# Local dev (portable Redis 5):
#   Start-Process "C:\Users\HP\redis5-portable\redis-server.exe" -ArgumentList "--port 6379"
#   or start the Memurai service (see start-dev.ps1)
# Production: Render Key Value → use its internal host/port.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Optional. Leave SMS_PROVIDER empty to disable SMS delivery.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PHONE_DEFAULT_COUNTRY_CODE=251
