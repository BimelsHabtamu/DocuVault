# ══════════════════════════════════════════════════════════════════
#  DocuVault — Server Environment Configuration
#  ALL fields below are REQUIRED. The server will refuse to start
#  if any are missing or still show placeholder values.
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pdf_engine_db

# ── Auth tokens ───────────────────────────────────────────────────
# JWT_SECRET:            Long random string used to sign login tokens.
#                        Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# DOWNLOAD_TOKEN_SECRET: Different secret for delivery download links.
#                        Generate the same way.
JWT_SECRET=pdf_engine_super_secret_key_2026
DOWNLOAD_TOKEN_SECRET=download_token_secret_key_2026
JWT_EXPIRES_IN=7d

# ── Server port ───────────────────────────────────────────────────
PORT=5000

# ── Frontend URL (used in email links + QR codes) ────────────────
# LOCAL DEVELOPMENT with ngrok:
#   1. Run:  ngrok http 5173
#   2. Copy the HTTPS URL ngrok gives you, e.g. https://abc123.ngrok-free.app
#   3. Set it here and restart the backend:
#        CLIENT_URL=https://abc123.ngrok-free.app
#   4. Re-deliver any document — old tokens still use the old URL.
#
# LOCAL DEVELOPMENT on same WiFi (no ngrok):
#   CLIENT_URL=http://10.172.46.138:5173   ← your machine's LAN IP
#
# PRODUCTION:
#   CLIENT_URL=https://yourdomain.com
#
# This value is embedded in:
#   - Recipient "Open Document" email button
#   - QR code verification URL (phone scans this)
#   - Email change verification links
#   - Approver review links
CLIENT_URL=http://10.172.46.138:5173

# ══════════════════════════════════════════════════════════════════
#  EMAIL — MANDATORY
#  DocuVault sends real emails for:
#    • OTP codes to approvers
#    • Document delivery to recipients
#    • Email change verification
#    • Password change security alerts
#    • Set-password links for new recipients
#    • 24h/72h escalation reminders
#
#  HOW TO SET UP GMAIL (recommended for testing):
#  ─────────────────────────────────────────────
#  1. Go to https://myaccount.google.com/security
#  2. Enable "2-Step Verification" (required for App Passwords)
#  3. Go to https://myaccount.google.com/apppasswords
#  4. Select app: "Mail" → Select device: "Other" → name it "DocuVault"
#  5. Google gives you a 16-character App Password (e.g. abcd efgh ijkl mnop)
#  6. Copy it WITHOUT spaces → paste into MAIL_PASS below
#
#  MAIL_HOST for Gmail:  smtp.gmail.com
#  MAIL_PORT for Gmail:  587
#  MAIL_USER:            your full Gmail address
#  MAIL_PASS:            the 16-char App Password (NOT your Gmail login password)
#
#  HOW TO SET UP OUTLOOK / OFFICE 365:
#  ────────────────────────────────────
#  MAIL_HOST=smtp.office365.com
#  MAIL_PORT=587
#  MAIL_USER=your@organization.com
#  MAIL_PASS=your_password
#
#  HOW TO SET UP A CUSTOM SMTP (e.g. cPanel, Zoho, SendGrid):
#  ────────────────────────────────────────────────────────────
#  MAIL_HOST=mail.yourdomain.com   (get from hosting provider)
#  MAIL_PORT=587                   (or 465 for SSL)
#  MAIL_USER=noreply@yourdomain.com
#  MAIL_PASS=your_smtp_password
#
#  TESTING WITHOUT A REAL SMTP:
#  ─────────────────────────────
#  Use Mailtrap (https://mailtrap.io) — free sandbox inbox.
#  Sign up → Inboxes → Show Credentials → copy SMTP settings below.
#  All sent emails appear in your Mailtrap inbox, never to real addresses.
# ══════════════════════════════════════════════════════════════════
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=bimelshabtamu152@gmail.com
MAIL_PASS=nuzzygibcjoyliei
