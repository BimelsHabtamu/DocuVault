    "items": {
      "generateDoc": {
        "q": "ሰነድ እንዴት እፈጥራለሁ?",
        "a": "በጎነ-ምናሌ ውስጥ \"ሰነዶቼ\" ይሂዱ። ከተቆልቋዩ ዝርዝር ውስጥ ንቁ ቴምፕሌት ይምረጡ፣ ሰነዱ ለሚሆንለት ሰው የሚሆን የመዝገብ መለያ ያስገቡ፣ የተሞሉ ይዘቶችን ለማየት \"ቅድሚያ ይመልከቱ\" ይጠቅሙ፣ ከዚያ የመጨረሻ ፒዲኤፍ ለማፍጠር \"ፍጠር\" ይጠቅሙ። ሰነዱ ወደፊት እንዲሄድ አጽዳቂ ለመምደብ ውይይት ይጠይቃል።"
      },
      "requestEsign": {
        "q": "ኢ-ፊርማ እንዴት እጠይቃለሁ (ለማጽደቅ እልካለሁ)?",
        "a": "ሰነድ ከፈጠሩ በኋላ ወዲያውኑ አጽዳቂ ለመምረጥ ይጠየቃሉ። ይህ ደረጃ ካለፉ፣ \"የሰነድ ክትትል\" ይክፈቱ፣ ሁኔታው ረቂቅ የሆነ ሰነዱን ያግኙ፣ እና \"አጽዳቂ ይምደቡ\" እርምጃን ይጠቅሙ። ስርዓቱ አጽዳቂው ሰው ወደ ኢሜይሉ አንድ ጊዜ ደህንነቱ የተጠበቀ የግምገማ ማገናኛ ይልካል።"
      },
      "otpApproval": {
        "q": "OTP ማጽደቅ እንዴት ይሰራል?",
        "a": "ሰነድ ለማጽደቅ ሲቀርብ፣ የተሾመው አጽዳቂ ሰው አንድ ጊዜ ደህንነቱ የተጠበቀ የግምገማ ማገናኛ ባለው ኢሜይል ይቀበላል። ያ ማገናኛ ሲከፈት በተናጠል ኢሜይል የሚላክ 6-አሃዝ OTP ያስፈልጋል። ትክክለኛ OTP ካስገቡ በኋላ አጽዳቂው ሙሉ ፒዲኤፍ ማንበብ ከዚያም ያጽድቅ ወይም ውድቅ ያድርግ ማለት ይችላል። OTP ከ15 ደቂቃ በኋላ ይቃጠላል፤ ከ3 ቀናት ሙከራ በኋላ ማገናኛ ለ15 ደቂቃ ይቆለፋል።"
      },
      "approveReject": {
        "q": "ሰነድ እንዴት ያጸድቃሉ ወይም ውድቅ ያደርጋሉ?",
        "a": "አጽዳቂዎች በጎነ-ምናሌ ውስጥ \"ጠባቂ ማጽደቂያዎች\" ስር ወይም ማሳወቂያ ኢሜይሉ ላይ ያለ ማገናኛ ጠቅ በማድረግ ጠባቂ ጥያቄዎችን ያያሉ። ጥያቄውን ይክፈቱ፣ OTP ያስገቡ፣ ፒዲኤፍ ይገምግሙ፣ ከዚያ ያጽድቁ ወይም ውድቅ ያድርጉ ይጠቅሙ። ውድቀት ለሰነዱ ጄኔሬተር የሚላክ ምክንያት ያስፈልጋል።"
      },
      "secureDelivery": {
        "q": "አስተማማኝ አቅርቦት እንዴት ይሰራል?",
        "a": "ሰነድ ጸድቆ ከተፈረመ በኋላ፣ ጄኔሬተሩ \"የሰነድ ክትትል → አቅርብ\" በኩል ለተቀባዩ ሊልክ ይችላል። ተቀባዩ ኢሜይሉ ላይ አንድ ጊዜ ደህንነቱ የተጠበቀ ማገናኛ ይቀበላል። ማገናኛውን ሲከፍት ማንነቱን በOTP ያረጋግጣል፣ ፒዲኤፍ ቅድሚያ ይመለከታል፣ ባለቤትነቱን ያረጋግጣል ወይም ይቃወማል፣ ከዚያ ሰነዱን ያወርዳል። ማገናኛ አንድ ጊዜ ብቻ ጥቅም ላይ ይዋላል እና ከ7 ቀናት በኋላ ይቃጠላል።"
      },
