# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Environment files (contains secrets)
# Covers .env, .env.local, .env.production, .env.staging — every variant.
# .env.production in particular held real Render/MySQL/SMTP credentials and was
# NOT matched by the narrower patterns below, so it was one `git add .` away
# from being committed.
.env
.env.local
.env.*.local
.env.*
**/.env
**/.env.local
**/.env.*.local
**/.env.*
!**/.env.example
!**/.env.production.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Coverage
coverage/

# Runtime file storage — generated PDFs, uploaded logos/avatars/seals/signatures,
# bulk ZIPs and the cold-storage archive. These are user data recreated at
# runtime (and backed by a persistent disk in production), never source. The
# .gitkeep files preserve the directory structure in a fresh clone.
server/storage/**
!server/storage/**/.gitkeep
